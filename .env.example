PORT=3000
CORS_PORT=http://localhost:8080
# MinIO (almacén del data lake)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=cambiar
MINIO_BUCKET=datalake

# MariaDB / MySQL (base de datos de servicio para métricas)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=servicio
DB_ROOT_PASSWORD=

# Firma de tokens de autenticación. Use un secreto aleatorio y privado.
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio

# Respaldo programado (node-cron): "minuto hora día mes día-semana"
RESPALDO_CRON="0 2 * * *"
# Zona horaria IANA (opcional); vacía = hora local del servidor
RESPALDO_ZONA=
# Recálculo programado de las métricas que lee el front (tablas de tablas.sql)
METRICAS_CRON="30 2 * * *"
# Datasets del bucket de donde salen las métricas
DATASET_VENTAS=ventas
DATASET_INVENTARIO=inventario
DATASET_COMPRAS=compras
DATASET_METAS=metas
# % de comisión del vendedor sobre lo cobrado sin IVA
COMISION_VENDEDOR=3
