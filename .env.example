PORT=3000
CORS_PORT=http://localhost:8080
# MinIO (almacén del data lake)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=cambiar
MINIO_BUCKET=datalake

# MariaDB / MySQL (base de datos de servicio para métricas)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=servicio
DB_ROOT_PASSWORD=

# Firma de tokens de autenticación. Use un secreto aleatorio y privado.
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio

# DolarApi Venezuela: sugiere las tasas BCV, paralelo (USDT) y EUR al registrar la tasa del día
DOLARAPI_URL=https://ve.dolarapi.com/v1
DOLARAPI_TIMEOUT_MS=8000

# Respaldo programado (node-cron): "minuto hora día mes día-semana"
RESPALDO_CRON="0 2 * * *"
# Zona horaria IANA (opcional); vacía = hora local del servidor
RESPALDO_ZONA=
# Segunda copia del respaldo (disco externo, NAS o carpeta sincronizada con la nube) y días que se conservan
RESPALDO_DIR=./respaldos
RESPALDO_RETENCION_DIAS=14
# Recálculo programado de las métricas que lee el front (tablas de tablas.sql)
METRICAS_CRON="30 2 * * *"
# Revisión cada 15 min: recalcula solo si hay reportes nuevos desde el último cálculo
METRICAS_INCREMENTAL_CRON="*/15 * * * *"
# Datasets del bucket de donde salen las métricas
DATASET_VENTAS=ventas
DATASET_INVENTARIO=inventario
DATASET_COMPRAS=compras
DATASET_METAS=metas
DATASET_TASAS=tasas
# Horas sin actualizar la tasa de cambio antes de alertar
HORAS_TASA_VIGENTE=24
# Desfase horario del negocio respecto a UTC
DESFASE_NEGOCIO=-04:00
# % de comisión del vendedor sobre lo cobrado sin IVA
COMISION_VENDEDOR=3
# Z del nivel de servicio para el inventario de seguridad (1.65 = 95 %)
NIVEL_SERVICIO_Z=1.65
# Alfa del suavizamiento exponencial simple (previsión de demanda)
ALFA_SUAVIZAMIENTO=0.3
